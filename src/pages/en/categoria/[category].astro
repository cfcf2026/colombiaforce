---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { CATEGORY_SLUGS, CATEGORY_LABELS } from '../../../categories';

export async function getStaticPaths() {
	return CATEGORY_SLUGS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const allPosts = await getCollection('blog', ({ id }) => id.startsWith('en/'));
const posts = allPosts
	.filter((post) => post.data.category === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const label = CATEGORY_LABELS.en[category as (typeof CATEGORY_SLUGS)[number]] ?? category;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${label} — ${SITE_TITLE}`} description={`News in the ${label} category on ${SITE_TITLE}.`} />
		<style>
			main {
				width: 960px;
			}
			h1 {
				margin-bottom: 1.5rem;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{label}</h1>
			{posts.length === 0 && <p class="empty">No articles in this category yet.</p>}
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/en/blog/${post.id.replace(/^en\//, '')}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
