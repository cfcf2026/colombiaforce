---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const otherPath = '/' + otherLang + Astro.url.pathname.slice(('/' + lang).length || 0);
---

<header>
	<nav>
		<h2><a href={`/${lang}/`}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={`/${lang}/`}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={`/${lang}/blog`}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={`/${lang}/about`}>{t('nav.about')}</HeaderLink>
			<HeaderLink href={`/${lang}/categoria/operativos`}>{t('cat.operativos')}</HeaderLink>
			<HeaderLink href={`/${lang}/categoria/incautaciones`}>{t('cat.incautaciones')}</HeaderLink>
			<HeaderLink href={`/${lang}/categoria/sometimientos`}>{t('cat.sometimientos')}</HeaderLink>
			<HeaderLink href={`/${lang}/categoria/bajas`}>{t('cat.bajas')}</HeaderLink>
		</div>
		<div class="lang-switch">
			<a href={otherPath}>{otherLang.toUpperCase()}</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.lang-switch a {
		font-weight: bold;
		border: 1px solid rgb(var(--gray));
		border-radius: 6px;
		padding: 0.3em 0.7em !important;
	}
	@media (max-width: 720px) {
		.internal-links {
			font-size: 0.85em;
		}
	}
</style>
