---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { SITE_TITLE } from '../consts';
import { useTranslations } from '../i18n/ui';
import { postPath, categoryPath } from '../i18n/routes';
import { DEPARTMENT_NAMES } from '../departments';

interface Props {
	lang: 'es' | 'en';
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
	es: {
		desc: 'Resumen diario de operativos, incautaciones y resultados de la ofensiva contra la criminalidad en Colombia, con base en fuentes oficiales.',
		featured: 'Nota destacada',
		read: 'Leer la nota',
		seeMap: 'Ver el mapa',
		all: 'Todas',
		latest: 'Últimas notas',
		empty: 'Todavía no hay notas.',
		more: 'Pronto habrá más notas.',
		mapTitle: 'Mapa por departamento',
		hover: 'Pasa el mouse sobre un departamento',
		hint: 'Notas publicadas por departamento y categoría. Las notas de alcance nacional no se asignan a un departamento.',
		mapError: 'No se pudo cargar el mapa',
	},
	en: {
		desc: "Daily briefing on operations, seizures and results of Colombia's offensive against crime, based on official sources.",
		featured: 'Featured report',
		read: 'Read the story',
		seeMap: 'See the map',
		all: 'All',
		latest: 'Latest reports',
		empty: 'No reports yet.',
		more: 'More reports coming soon.',
		mapTitle: 'Map by department',
		hover: 'Hover over a department',
		hint: 'Published reports by department and category. Nationwide reports are not assigned to a department.',
		mapError: 'The map could not be loaded',
	},
}[lang];

const catSlugs = ['operativos', 'incautaciones', 'sometimientos', 'bajas'];
const catLabel: Record<string, string> = {
	operativos: t('cat.operativos'),
	incautaciones: t('cat.incautaciones'),
	sometimientos: t('cat.sometimientos'),
	bajas: t('cat.bajas'),
};

const prefix = `${lang}/`;
const posts = (await getCollection('blog', ({ id }) => id.startsWith(prefix))).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts[0];
const postHref = (p: (typeof posts)[number]) => postPath(lang, p);
const label = (p: (typeof posts)[number]) => catLabel[p.data.category as string] ?? '';

const nationalStats = { operativos: 0, incautaciones: 0, sometimientos: 0, bajas: 0 };
for (const p of posts) nationalStats[p.data.category] += 1;
const nationalTotal = Object.values(nationalStats).reduce((a, b) => a + b, 0);
const mapCopy =
	lang === 'es'
		? { national: 'Total nacional', sub: 'Todas las notas publicadas', one: 'nota', many: 'notas', reset: 'Ver total nacional', tap: 'Toca o pasa el mouse sobre un departamento.' }
		: { national: 'Nationwide total', sub: 'All published reports', one: 'report', many: 'reports', reset: 'Show nationwide total', tap: 'Tap or hover over a department.' };
const nationalSubtitle = `${mapCopy.sub} · ${nationalTotal} ${nationalTotal === 1 ? mapCopy.one : mapCopy.many}`;

const mapStats: Record<string, Record<string, number>> = {};
for (const p of posts) {
	for (const d of p.data.departments ?? []) {
		mapStats[d] ??= { operativos: 0, incautaciones: 0, sometimientos: 0, bajas: 0 };
		mapStats[d][p.data.category] += 1;
	}
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={copy.desc} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
	</head>
	<body>
		<Header />
		<main class="wide">
			<h1 class="sr-only">{SITE_TITLE}</h1>

			<section class="hero">
				<div class="hero-text">
					<p class="eyebrow">{copy.featured}</p>
					<h2>{featured ? featured.data.title : SITE_TITLE}</h2>
					<p class="summary">{featured ? featured.data.description : copy.desc}</p>
					<div class="actions">
						{featured && <a class="btn primary" href={postHref(featured)}>{copy.read}</a>}
						<a class="btn ghost" href="#mapa">{copy.seeMap}</a>
					</div>
				</div>
				<div class="hero-art">
					{featured?.data.heroImage ? <img class="hero-img" src={featured.data.heroImage} alt={featured.data.imageAlt ?? ''} /> : <svg aria-hidden="true" viewBox="0 0 340 360" width="240" height="254"><polygon points="120,20 170,10 215,40 250,35 290,70 275,110 300,150 280,200 255,250 265,300 220,330 170,310 130,330 90,290 60,240 85,200 50,170 70,120 100,80" fill="#1b2963" stroke="#ffd21a" stroke-width="2" stroke-linejoin="round"></polygon></svg>}
				</div>
			</section>

			<section id="mapa" class="map-section">
				<h2 class="section-title">{copy.mapTitle}</h2>
				<div class="map-wrap">
					<div id="colombia-map" data-error={copy.mapError} data-stats={JSON.stringify(mapStats)} data-names={JSON.stringify(DEPARTMENT_NAMES)} data-national={JSON.stringify(nationalStats)} data-copy={JSON.stringify(mapCopy)}></div>
					<div id="map-panel">
						<h3 id="map-panel-title">{mapCopy.national}</h3>
						<p id="map-panel-sub" class="sub">{nationalSubtitle}</p>
						<div class="stat-row"><span>{catLabel.operativos}</span><b id="stat-operativos">{nationalStats.operativos}</b></div>
						<div class="stat-row"><span>{catLabel.incautaciones}</span><b id="stat-incautaciones">{nationalStats.incautaciones}</b></div>
						<div class="stat-row"><span>{catLabel.sometimientos}</span><b id="stat-sometimientos">{nationalStats.sometimientos}</b></div>
						<div class="stat-row"><span>{catLabel.bajas}</span><b id="stat-bajas">{nationalStats.bajas}</b></div>
						<button id="map-reset" class="map-reset" type="button" hidden>{mapCopy.reset}</button>
						<div class="legend" aria-hidden="true"><span>{lang === 'es' ? 'Menos notas' : 'Fewer reports'}</span><i></i><span>{lang === 'es' ? 'Más notas' : 'More reports'}</span></div>
						<p class="hint">{mapCopy.tap} {copy.hint}</p>
					</div>
				</div>
			</section>

			<div class="latest">
				<h2 class="section-title">{copy.latest}</h2>
				<nav class="tabs" aria-label={copy.latest}>
				<a class="tab active" href={`/${lang}/blog`}>{copy.all}</a>
				{catSlugs.map((s) => <a class="tab" href={categoryPath(lang, s)}>{catLabel[s]}</a>)}
			</nav>

			{
				posts.length > 1 ? (
					<section class="grid">
						{posts.slice(1, 9).map((p) => (
							<a class="card" href={postHref(p)}>
								<div class="thumb" style={p.data.heroImage ? `background-image:url('${p.data.heroImage}')` : undefined}>{!p.data.heroImage && <span>{label(p)}</span>}</div>
								<div class="body">
									<p class="meta">{label(p)} · <FormattedDate date={p.data.pubDate} /></p>
									<h3>{p.data.title}</h3>
								</div>
							</a>
						))}
					</section>
				) : (
					<p class="muted">{posts.length ? copy.more : copy.empty}</p>
				)
			}
			</div>
		</main>
		<Footer />

		<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" is:inline></script>
		<script>
	declare const L: any;

	type Stats = { operativos: number; incautaciones: number; sometimientos: number; bajas: number };
	const KEYS = ['operativos', 'incautaciones', 'sometimientos', 'bajas'] as const;
	const EMPTY: Stats = { operativos: 0, incautaciones: 0, sometimientos: 0, bajas: 0 };

	document.addEventListener('DOMContentLoaded', async () => {
		const mapEl = document.getElementById('colombia-map');
		if (!mapEl) return;

		const byDept: Record<string, Stats> = JSON.parse(mapEl.dataset.stats ?? '{}');
		const national: Stats = { ...EMPTY, ...JSON.parse(mapEl.dataset.national ?? '{}') };
		const names: Record<string, string> = JSON.parse(mapEl.dataset.names ?? '{}');
		const txt = JSON.parse(mapEl.dataset.copy ?? '{}');

		const total = (s: Stats) => KEYS.reduce((sum, k) => sum + (s[k] ?? 0), 0);
		const statsOf = (name: string): Stats => byDept[name] ?? EMPTY;
		const maxTotal = Math.max(0, ...Object.values(byDept).map(total));
		const noteLabel = (n: number) => `${n} ${n === 1 ? txt.one : txt.many}`;

		const panelTitle = document.getElementById('map-panel-title');
		const panelSub = document.getElementById('map-panel-sub');
		const resetBtn = document.getElementById('map-reset') as HTMLButtonElement | null;
		const statEls = KEYS.map((k) => document.getElementById('stat-' + k));

		let selected: string | null = null;
		const layers = new Map<string, any>();

		// Muestra el departamento en hover o seleccionado; si no hay ninguno, el total nacional.
		function render(hover: string | null) {
			const name = hover ?? selected;
			const s = name ? statsOf(name) : national;
			if (panelTitle) panelTitle.textContent = name ? (names[name] ?? name) : txt.national;
			if (panelSub) panelSub.textContent = name ? noteLabel(total(s)) : `${txt.sub} · ${noteLabel(total(national))}`;
			KEYS.forEach((k, i) => {
				const el = statEls[i];
				if (el) el.textContent = String(s[k] ?? 0);
			});
			if (resetBtn) resetBtn.hidden = selected === null;
		}

		// Color según el número de notas del departamento.
		function styleFor(name: string, state?: 'hover' | 'selected') {
			const n = total(statsOf(name));
			const fill =
				n === 0
					? { fillColor: '#1b2963', fillOpacity: 0.65 }
					: { fillColor: '#ffd21a', fillOpacity: 0.3 + 0.6 * (n / maxTotal) };
			return {
				color: state ? '#ffffff' : '#ffd21a',
				weight: state === 'selected' ? 3 : state === 'hover' ? 2.5 : 1,
				...fill,
			};
		}

		function select(name: string | null) {
			const prev = selected;
			selected = name;
			if (prev) layers.get(prev)?.setStyle(styleFor(prev));
			if (name) {
				const l = layers.get(name);
				l?.setStyle(styleFor(name, 'selected'));
				l?.bringToFront();
			}
			render(null);
		}

		render(null);
		resetBtn?.addEventListener('click', () => select(null));

		const mobile = !!L.Browser.mobile;
		const canHover = window.matchMedia('(hover: hover)').matches;

		const map = L.map('colombia-map', {
			zoomControl: !mobile,
			scrollWheelZoom: false,
			dragging: !mobile,
			touchZoom: !mobile,
			doubleClickZoom: !mobile,
		}).setView([4.5, -74.3], 5);


		try {
			const res = await fetch('/data/colombia.geo.json');
			const geojson = await res.json();

			const layer = L.geoJSON(geojson, {
				style: (f: any) => styleFor(f.properties.NOMBRE_DPT),
				bubblingMouseEvents: false,
				onEachFeature: (feature: any, lyr: any) => {
					const name: string = feature.properties.NOMBRE_DPT;
					layers.set(name, lyr);
					lyr.on('mouseover', () => {
						if (!canHover) return;
						lyr.setStyle(styleFor(name, 'hover'));
						lyr.bringToFront();
						render(name);
					});
					lyr.on('mouseout', () => {
						if (!canHover) return;
						lyr.setStyle(styleFor(name, selected === name ? 'selected' : undefined));
						render(null);
					});
					lyr.on('click', () => select(selected === name ? null : name));
				},
			}).addTo(map);

			map.fitBounds(layer.getBounds());
			map.on('click', () => select(null));
		} catch (err) {
			console.error('No se pudo cargar el mapa de departamentos', err);
			if (panelTitle) panelTitle.textContent = mapEl.dataset.error ?? '';
		}
	});
</script>
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2.5rem;
		align-items: center;
		padding: 2.5rem 0 3rem;
	}
	.eyebrow {
		color: var(--accent);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin: 0 0 0.8rem;
	}
	.hero h2 {
		font-size: clamp(2.6rem, 6vw, 4.6rem);
		line-height: 0.98;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}
	.summary {
		font-size: 1.15rem;
		margin-bottom: 1.6rem;
	}
	.actions {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.8rem 1.4rem;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid var(--line);
		min-height: 44px;
		box-sizing: border-box;
	}
	.btn.primary {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}
	.btn.primary:hover {
		background: var(--accent-dark);
		color: var(--bg);
	}
	.btn.ghost {
		color: #fff;
	}
	.btn.ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.hero-art {
		background: var(--surface);
		border-bottom: 6px solid var(--red);
		min-height: 300px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.tabs {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 1.2rem;
	}
	.tab {
		padding: 0.55rem 1.1rem;
		background: var(--surface);
		color: #fff;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		min-height: 44px;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
	}
	.tab.active {
		background: var(--accent);
		color: var(--bg);
	}
	.tab:hover:not(.active) {
		background: var(--surface-2);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.2rem;
	}
	.card {
		display: block;
		background: var(--surface);
		text-decoration: none;
		color: #fff;
	}
	.card:hover {
		outline: 2px solid var(--accent);
	}
	.thumb {
		height: 120px;
		background: var(--surface-2);
		display: flex;
		align-items: flex-end;
		padding: 0.8rem 1rem;
		border-top: 3px solid var(--accent);
	}
	.thumb span {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 2rem;
		text-transform: uppercase;
		opacity: 0.3;
		line-height: 1;
	}
	.body {
		padding: 1rem 1.1rem 1.2rem;
	}
	.meta {
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 0.4rem;
	}
	.card h3 {
		font-size: 1.6rem;
		margin: 0;
	}
	.muted {
		color: rgb(var(--gray));
	}
	.map-section {
		margin-top: 4rem;
		scroll-margin-top: 90px;
	}
	.section-title {
		text-transform: uppercase;
		font-size: 2.2rem;
	}
	.map-wrap {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	#colombia-map {
		flex: 1 1 500px;
		height: 480px;
		background: #0e1840;
		border: 1px solid var(--line);
	}
	#map-panel {
		flex: 1 1 260px;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	#map-panel h3 {
		margin-top: 0;
		text-transform: uppercase;
	}
	.stat-row {
		display: flex;
		justify-content: space-between;
		padding: 0.5em 0;
		border-bottom: 1px solid var(--line);
	}
	.stat-row b {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: #fff;
	}
	.hint {
		color: rgb(var(--gray));
		font-size: 0.85em;
		margin: 1rem 0 0;
	}
	:global(.leaflet-control-attribution) {
		background: rgba(10, 18, 48, 0.85) !important;
		color: #8fa0c8 !important;
	}
	:global(.leaflet-control-attribution a) {
		color: #ffd21a !important;
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-top: 1rem;
		}
		.hero-art {
			min-height: 220px;
		}
		#colombia-map {
			height: 360px;
		}
	}
	.hero-img { width: 100%; height: 100%; min-height: 300px; max-height: 440px; object-fit: cover; display: block; }
	.hero-art { overflow: hidden; }
	.thumb { height: 160px; background-size: cover; background-position: center; }
	#map-panel .sub { color: rgb(var(--gray)); margin: -0.4rem 0 0.8rem; font-size: 0.9rem; }
	.map-reset { margin-top: 1rem; min-height: 44px; padding: 0.6rem 1.1rem; background: transparent; color: #fff; border: 1px solid var(--line); font-weight: 700; cursor: pointer; }
	.map-reset:hover { border-color: var(--accent); color: var(--accent); }
	.map-reset[hidden] { display: none; }
	.legend { display: flex; align-items: center; gap: 0.6rem; margin-top: 1rem; font-size: 0.8rem; color: rgb(var(--gray)); }
	.legend i { flex: 1; height: 8px; background: linear-gradient(90deg, rgba(255, 210, 26, 0.3), rgba(255, 210, 26, 0.9)); }
	@media (max-width: 860px) { #map-panel { order: -1; } }
	.map-section { margin-top: 0; }
	.latest { margin-top: 4rem; }
</style>
