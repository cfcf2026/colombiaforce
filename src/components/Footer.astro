---
const isEn = Astro.url.pathname.startsWith('/en');
const year = new Date().getFullYear();
---
<footer>
	<p class="brand">Colombia Force</p>
	<p class="tag">
		{isEn
			? "Independent daily briefing on Colombia's offensive against crime, based on official sources."
			: 'Resumen diario independiente de la ofensiva contra la criminalidad en Colombia, con base en fuentes oficiales.'}
	</p>
	<p class="copy">© {year} Colombia Force</p>
</footer>

<style>
	footer {
		padding: 2.5rem 1rem;
		margin-top: 3rem;
		text-align: center;
		border-top: 1px solid var(--line);
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.brand {
		font-family: var(--font-display);
		color: #fff;
		font-weight: 700;
		font-size: 1.4rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin: 0 0 0.4rem;
	}
	.tag {
		max-width: 560px;
		margin: 0 auto 0.8rem;
		line-height: 1.5;
	}
	.copy {
		margin: 0;
		font-size: 0.8rem;
		opacity: 0.7;
	}
</style>
